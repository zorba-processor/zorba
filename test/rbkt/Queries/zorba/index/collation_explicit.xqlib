module namespace c = "http://www.test.com/collation-explicit";

import module namespace dml = "http://zorba.io/modules/store/static/collections/dml";

declare namespace ann = "http://zorba.io/annotations";

declare collection c:coll as node()*;

declare %ann:value-equality %ann:manual index c:hash
on nodes dml:collection(xs:QName("c:coll"))
by string(@k) as xs:string collation "http://zorba.io/collations/PRIMARY/en/US";

declare %ann:value-range %ann:manual index c:tree
on nodes dml:collection(xs:QName("c:coll"))
by string(@k) as xs:string collation "http://zorba.io/collations/PRIMARY/en/US";

declare %ann:general-equality %ann:manual index c:general-hash
on nodes dml:collection(xs:QName("c:coll"))
by string(@k) as xs:string collation "http://zorba.io/collations/PRIMARY/en/US";

declare %ann:general-range %ann:manual index c:general-tree
on nodes dml:collection(xs:QName("c:coll"))
by string(@k) as xs:string collation "http://zorba.io/collations/PRIMARY/en/US";
