module namespace m = "http://www.example.com/general-numeric-promotion";

import module namespace ddl =
  "http://zorba.io/modules/store/static/collections/ddl";

import module namespace dml =
  "http://zorba.io/modules/store/static/collections/dml";

import module namespace iddl =
  "http://zorba.io/modules/store/static/indexes/ddl";

import module namespace idml =
  "http://zorba.io/modules/store/static/indexes/dml";

declare namespace an = "http://zorba.io/annotations";
declare namespace err = "http://www.w3.org/2005/xqt-errors";

(: Probed after a manual index build. :)
declare collection m:c as node()*;

(: Maintained by automatic indexes created before the data. :)
declare collection m:a as node()*;

(: Maintained by a unique automatic index. :)
declare collection m:u as node()*;

(: Typed keys only, so value probes are allowed. :)
declare collection m:v as node()*;

(: Listed by idml:keys. :)
declare collection m:k as node()*;

(: The key of e: untyped unless @t names a type. :)
declare function m:key($e as element(e)) as xs:anyAtomicType
{
  switch (fn:string($e/@t))
  case "ul" return xs:unsignedLong($e/@v)
  case "f" return xs:float($e/@v)
  case "d" return xs:double($e/@v)
  case "i" return xs:integer($e/@v)
  case "dec" return xs:decimal($e/@v)
  default return fn:data($e/@v)
};

declare %an:general-range %an:manual index m:Range
on nodes dml:collection(xs:QName("m:c"))//e
by (switch (fn:string(./@t))
    case "f" return xs:float(./@v)
    case "d" return xs:double(./@v)
    case "i" return xs:integer(./@v)
    case "dec" return xs:decimal(./@v)
    default return fn:data(./@v));

declare %an:general-equality %an:manual index m:Equality
on nodes dml:collection(xs:QName("m:c"))//e
by (switch (fn:string(./@t))
    case "f" return xs:float(./@v)
    case "d" return xs:double(./@v)
    case "i" return xs:integer(./@v)
    case "dec" return xs:decimal(./@v)
    default return fn:data(./@v));

declare %an:general-range %an:automatic index m:AutoRange
on nodes dml:collection(xs:QName("m:a"))
by (switch (fn:string(./@t))
    case "f" return xs:float(./@v)
    case "d" return xs:double(./@v)
    case "i" return xs:integer(./@v)
    case "dec" return xs:decimal(./@v)
    default return fn:data(./@v));

declare %an:general-equality %an:automatic index m:AutoEquality
on nodes dml:collection(xs:QName("m:a"))
by (switch (fn:string(./@t))
    case "f" return xs:float(./@v)
    case "d" return xs:double(./@v)
    case "i" return xs:integer(./@v)
    case "dec" return xs:decimal(./@v)
    default return fn:data(./@v));

declare %an:general-range %an:manual index m:VRange
on nodes dml:collection(xs:QName("m:v"))//e
by (switch (fn:string(./@t))
    case "ul" return xs:unsignedLong(./@v)
    case "f" return xs:float(./@v)
    case "d" return xs:double(./@v)
    case "i" return xs:integer(./@v)
    default return xs:decimal(./@v));

declare %an:general-equality %an:manual index m:VEquality
on nodes dml:collection(xs:QName("m:v"))//e
by (switch (fn:string(./@t))
    case "ul" return xs:unsignedLong(./@v)
    case "f" return xs:float(./@v)
    case "d" return xs:double(./@v)
    case "i" return xs:integer(./@v)
    default return xs:decimal(./@v));

declare %an:general-equality %an:automatic index m:Keys
on nodes dml:collection(xs:QName("m:k"))
by (switch (fn:string(./@t))
    case "f" return xs:float(./@v)
    case "i" return xs:integer(./@v)
    case "dec" return xs:decimal(./@v)
    default return fn:data(./@v));

(: A unique general index needs a declared key type (ZDST0025), so all its
   keys are of that type. :)
declare %an:unique %an:general-equality %an:automatic index m:Unique
on nodes dml:collection(xs:QName("m:u"))
by xs:decimal(./@v) as xs:decimal;

declare function m:rows() as element(e)*
{
  <e id="1" t="f" v="0.1"/>,
  <e id="2" t="f" v="16777216"/>,
  <e id="3" t="f" v="1e11"/>,
  <e id="4" t="i" v="16777217"/>,
  <e id="5" t="i" v="16777216"/>,
  <e id="6" t="i" v="100000000001"/>,
  <e id="7" t="i" v="100000006144"/>,
  <e id="8" t="dec" v="0.1"/>,
  <e id="9" t="dec" v="0.1000000000000000000001"/>,
  <e id="10" t="dec" v="16777217.000000000000000001"/>,
  <e id="11" t="dec" v="10000000000000000001"/>,
  <e id="12" v="3"/>,
  <e id="13" t="dec" v="0.5"/>,
  <e id="14" t="d" v="0.1"/>,
  <e id="15" v="100000000000"/>,
  <e id="16" t="i" v="100000000000"/>
};

declare %an:sequential function m:init()
{
  ddl:create(xs:QName("m:c"));
  dml:insert(xs:QName("m:c"), <r>{ m:rows() }</r>);
  iddl:create(xs:QName("m:Range"));
  iddl:create(xs:QName("m:Equality"));
};

(: The indexes exist before the data, so inserts and deletes maintain them. :)
declare %an:sequential function m:init-maintained()
{
  ddl:create(xs:QName("m:a"));
  iddl:create(xs:QName("m:AutoRange"));
  iddl:create(xs:QName("m:AutoEquality"));
  dml:insert(xs:QName("m:a"), m:rows());
  dml:delete(dml:collection(xs:QName("m:a"))[@id = ("6", "9", "11", "15")]);
};

declare function m:ids($nodes as node()*) as xs:string
{
  fn:string-join(
    for $e in $nodes
    order by xs:integer($e/@id)
    return fn:string($e/@id),
    " ")
};

(: An empty selection is shown as "none", so no line ends with a space. :)
declare function m:shown($ids as xs:string) as xs:string
{
  if ($ids eq "") then "none" else $ids
};

declare function m:result($name as xs:string,
                          $indexed as xs:string,
                          $unindexed as xs:string) as xs:string
{
  fn:concat($name, ": ", m:shown($indexed),
            if ($indexed eq $unindexed) then ""
            else fn:concat(" (unindexed: ", m:shown($unindexed), ")"))
};

declare function m:elements($coll as xs:QName) as element(e)*
{
  dml:collection($coll)/descendant-or-self::e
};

(: The same selection without the index, by general comparison on the key. :)
declare function m:point($name as xs:string,
                         $coll as xs:QName,
                         $index as xs:QName,
                         $key as xs:anyAtomicType) as xs:string
{
  m:result($name,
           m:ids(idml:probe-index-point-general($index, $key)),
           m:ids(for $e in m:elements($coll)
                 where m:key($e) = $key
                 return $e))
};

declare function m:range($name as xs:string,
                         $coll as xs:QName,
                         $index as xs:QName,
                         $lower as xs:anyAtomicType?,
                         $upper as xs:anyAtomicType?,
                         $inclusive as xs:boolean) as xs:string
{
  m:result($name,
           m:ids(idml:probe-index-range-general($index,
                                                $lower,
                                                $upper,
                                                fn:exists($lower),
                                                fn:exists($upper),
                                                $inclusive,
                                                $inclusive)),
           m:ids(for $e in m:elements($coll)
                 let $k := m:key($e)
                 where (fn:empty($lower) or
                        (if ($inclusive) then $k >= $lower else $k > $lower))
                       and
                       (fn:empty($upper) or
                        (if ($inclusive) then $k <= $upper else $k < $upper))
                 return $e))
};

(: Inserts $first, then $second into the unique index and reports whether the
   second insert raised; empties m:u. :)
declare %an:sequential function m:unique($name as xs:string,
                                         $first as element(e),
                                         $second as element(e)) as xs:string
{
  ddl:create(xs:QName("m:u"));
  iddl:create(xs:QName("m:Unique"));
  dml:insert(xs:QName("m:u"), $first);

  variable $outcome :=
    try
    {{
      dml:insert(xs:QName("m:u"), $second);
      "inserted"
    }}
    catch *
    {
      fn:local-name-from-QName($err:code)
    };

  iddl:delete(xs:QName("m:Unique"));
  ddl:delete(xs:QName("m:u"));

  fn:concat($name, ": ", $outcome)
};

(: Keys at the limits of the numeric types; none is untyped. :)
declare %an:sequential function m:init-limits()
{
  ddl:create(xs:QName("m:v"));
  dml:insert(xs:QName("m:v"),
             <r>
               <e id="1" t="i" v="9223372036854775807"/>
               <e id="2" t="i" v="-9223372036854775808"/>
               <e id="3" t="ul" v="18446744073709551615"/>
               <e id="4" t="dec" v="9223372036854775808"/>
               <e id="5" t="i" v="9007199254740993"/>
               <e id="6" t="dec" v="9007199254740993.4"/>
               <e id="7" t="dec" v="9007199254740994.6"/>
               <e id="8" t="i" v="0"/>
               <e id="9" t="d" v="-0"/>
               <e id="10" t="d" v="INF"/>
               <e id="11" t="d" v="-INF"/>
               <e id="12" t="dec" v="1000000000000000000000000000000000000000"/>
               <e id="13" t="f" v="0.5"/>
             </r>);
  iddl:create(xs:QName("m:VRange"));
  iddl:create(xs:QName("m:VEquality"));
};

(: The same selection without the index, by value comparison on the key. :)
declare function m:point-value($name as xs:string,
                               $index as xs:QName,
                               $key as xs:anyAtomicType) as xs:string
{
  m:result($name,
           m:ids(idml:probe-index-point-value($index, $key)),
           m:ids(for $e in m:elements(xs:QName("m:v"))
                 where m:key($e) eq $key
                 return $e))
};

declare function m:range-value($name as xs:string,
                               $lower as xs:anyAtomicType?,
                               $upper as xs:anyAtomicType?) as xs:string
{
  m:result($name,
           m:ids(idml:probe-index-range-value(xs:QName("m:VRange"),
                                              $lower, $upper,
                                              fn:exists($lower),
                                              fn:exists($upper),
                                              fn:true(), fn:true())),
           m:ids(for $e in m:elements(xs:QName("m:v"))
                 let $k := m:key($e)
                 where (fn:empty($lower) or $k ge $lower) and
                       (fn:empty($upper) or $k le $upper)
                 return $e))
};

declare %an:sequential function m:keys() as xs:string
{
  ddl:create(xs:QName("m:k"));
  dml:insert(xs:QName("m:k"), (<e id="1" t="f" v="0.5"/>,
                               <e id="2" v="7"/>,
                               <e id="3" t="dec" v="0.25"/>,
                               <e id="4" t="i" v="16777217"/>));
  fn:concat("keys: ",
    fn:string-join(
      for $a in idml:keys(xs:QName("m:Keys"))/*:attribute
      let $k := fn:concat(fn:string($a/@type), " ", fn:string($a/@value))
      order by $k
      return $k,
      ", "))
};
