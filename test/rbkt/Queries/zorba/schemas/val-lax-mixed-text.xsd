<xs:schema
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  targetNamespace="http://zorba.io/test/val-lax-mixed-text"
  xmlns="http://zorba.io/test/val-lax-mixed-text"
  elementFormDefault="qualified">

  <xs:element name="m">
    <xs:complexType mixed="true">
      <xs:sequence>
        <xs:element ref="k" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- element-only content: an xsi:type naming a simple type does not derive from it -->
  <xs:element name="k">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="e" type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
