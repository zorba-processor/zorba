<xs:schema
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  targetNamespace="http://zorba.io/test/val-lax-subtree"
  xmlns="http://zorba.io/test/val-lax-subtree"
  elementFormDefault="qualified">

  <xs:element name="n" type="xs:integer"/>

  <!-- no type: its content is a lax wildcard -->
  <xs:element name="any"/>

  <xs:element name="skip">
    <xs:complexType>
      <xs:sequence>
        <xs:any namespace="##any" processContents="skip"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
