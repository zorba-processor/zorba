(: Purpose: Library module which imports another library :)
(:   module with an external variable                    :)
(:*******************************************************:)
module namespace zm-A = "http://zorba-tests.example.org/modules-A";

import module namespace zm-B = "http://zorba-tests.example.org/modules-B"
at "extvarModule-B.xqlib";


declare function zm-A:getVar()
{
  zm-B:getVar()
};
