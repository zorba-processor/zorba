(: Integers in and just outside the range of the shared store items (-128 to 1023,
   see BasicItemFactory::createInteger) against xs:decimal and xs:double.
   XQuery 3.0 B.1: "A function that expects a parameter $p of type xs:decimal can be
   invoked with a value of type xs:integer. This is an example of subtype
   substitution." "A value of type xs:decimal [...] can be promoted to either of the
   types xs:float or xs:double."
   F&O 3.0 4.2: "If the two operands are not of the same type, subtype substitution
   and numeric type promotion are used to obtain two operands of the same type."
   F&O 3.0 op:numeric-equal: "Returns true if and only if the value of $arg1 is equal
   to the value of $arg2."
   F&O 3.0 fn:distinct-values compares with eq; XQuery 3.0 3.10.7 groups with
   fn:deep-equal: equal values must hash equally for either to find them equal.
   Each token: <label>=<distinct-values count><group by count><deep-equal>:<pairs with
   eq true, of 4>:<index-of second>:<stable order by positions>. :)
declare namespace err = "http://www.w3.org/2005/xqt-errors";

declare function local:t($b as xs:boolean) as xs:string { if ($b) then "t" else "f" };
declare function local:s($p as xs:integer*) as xs:string { string-join($p ! string(.), ",") };

(
  try { concat("-129-dec=",
      count(distinct-values((-129, -129.0))),
      count(for $x in (-129, -129.0) group by $k := $x return 1),
      local:t(deep-equal(-129, -129.0)), ":",
      count(for $x in (-129, -129.0), $y in (-129, -129.0) where $x eq $y return 1), ":",
      local:s(index-of((-129, -129.0), -129.0)), ":",
      local:s(for $x at $p in (-129, -129.0) stable order by $x return $p))
  } catch * { concat("-129-dec=", local-name-from-QName($err:code)) },
  try { concat("dec--129=",
