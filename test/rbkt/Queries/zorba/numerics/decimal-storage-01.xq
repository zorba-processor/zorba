(: Canonical form of xs:decimal values (values of every size kept in the
   store). :)
string-join(
  for $s in ( "0", "-0", "-0.0", "0.000", "+1", "1.0", "1.50", "100",
              "-123.25", ".5", "5.", "0.001", "0.000000000000000001",
              "9223372036854775807", "-9223372036854775808",
              "9223372036854775808", "18446744073709551616.25",
              "123456789012345678901234567890.123456789" )
  return string( xs:decimal( $s ) ),
  " " )
