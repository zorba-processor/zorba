{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_DISABLE_FIND_PACKAGE_Java": "ON",
        "CMAKE_DISABLE_FIND_PACKAGE_JNI": "ON"
      }
    },
    {
      "name": "core-release",
      "displayName": "Core (no XML Schema, no unit tests), Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ZORBA_NO_XMLSCHEMA": "ON",
        "CMAKE_DISABLE_FIND_PACKAGE_XercesC": "ON",
        "ZORBA_WITH_UNIT_TESTS": "OFF"
      }
    },
    {
      "name": "full-release",
      "displayName": "Full (XML Schema via Xerces-C), Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "full-debug",
      "displayName": "Full (XML Schema via Xerces-C), Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "asan",
      "displayName": "Full, AddressSanitizer + LeakSanitizer + UBSan (Linux)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ZORBA_HARDENING": "OFF",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize=vptr",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize=vptr",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize=vptr",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize=vptr",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize=vptr"
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0"
      }
    },
    {
      "name": "tsan",
      "displayName": "Full, ThreadSanitizer (Linux)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ZORBA_HARDENING": "OFF",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O1 -g -fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O1 -g -fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "tsan-bigint",
      "displayName": "Full, ThreadSanitizer, arbitrary-precision xs:integer (Linux)",
      "inherits": "tsan",
      "cacheVariables": {
        "ZORBA_WITH_BIG_INTEGER": "ON"
      }
    },
    {
      "name": "embedded",
      "displayName": "Embedded (no Full-Text, no XML Schema, no debugger, no thesaurus, no network, no unit tests), Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ZORBA_NO_FULL_TEXT": "ON",
        "ZORBA_NO_XMLSCHEMA": "ON",
        "ZORBA_WITH_DEBUGGER": "OFF",
        "ZORBA_WITH_THESAURUS": "OFF",
        "CMAKE_DISABLE_FIND_PACKAGE_XercesC": "ON",
        "ZORBA_SUPPRESS_CURL": "ON",
        "ZORBA_WITH_UNIT_TESTS": "OFF"
      }
    },
    {
      "name": "embedded-noicu",
      "displayName": "Embedded without ICU, Release",
      "inherits": "embedded",
      "cacheVariables": {
        "ZORBA_NO_ICU": "ON"
      }
    },
    {
      "name": "full-nopch",
      "displayName": "Full, precompiled header disabled, Release",
      "inherits": "full-release",
      "cacheVariables": {
        "ZORBA_USE_PCH": "OFF",
        "ZORBA_WITH_DEBUGGER": "ON",
        "ZORBA_XQUERYX": "ON",
        "ZORBA_TEST_XQUERYX": "ON"
      }
    },
    {
      "name": "bigint",
      "displayName": "Full, arbitrary-precision xs:integer (MAPM), Release",
      "inherits": "full-release",
      "cacheVariables": {
        "ZORBA_WITH_BIG_INTEGER": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "core-release",
      "configurePreset": "core-release"
    },
    {
      "name": "full-release",
      "configurePreset": "full-release"
    },
    {
      "name": "full-debug",
      "configurePreset": "full-debug"
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0"
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "tsan-bigint",
      "configurePreset": "tsan-bigint"
    },
    {
      "name": "embedded",
      "configurePreset": "embedded"
    },
    {
      "name": "embedded-noicu",
      "configurePreset": "embedded-noicu"
    },
    {
      "name": "full-nopch",
      "configurePreset": "full-nopch"
    },
    {
      "name": "bigint",
      "configurePreset": "bigint"
    }
  ],
  "testPresets": [
    {
      "name": "full-release",
      "displayName": "All tests (needs the HTTP test server, see test/http-test-data/README.txt)",
      "configurePreset": "full-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 120
      }
    },
    {
      "name": "full-release-offline",
      "displayName": "All tests except those that need the HTTP test server",
      "inherits": "full-release",
      "filter": {
        "exclude": {
          "name": "http-client|test/api/validate$|userdefined_uri_resolution|uri_resolvers|streaming-udf|store/example_[13]$|uris/disable-http-3|update/zorba/store/sc1"
        }
      }
    },
    {
      "name": "full-debug",
      "configurePreset": "full-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 300
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": false
      },
      "execution": {
        "timeout": 600
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:log_path=${sourceDir}/build/asan/sanitizer-logs/asan",
        "LSAN_OPTIONS": "suppressions=${sourceDir}/test/sanitizers/lsan.supp",
        "UBSAN_OPTIONS": "print_stacktrace=1:log_path=${sourceDir}/build/asan/sanitizer-logs/ubsan"
      }
    },
    {
      "name": "tsan",
      "displayName": "Thread-safety tests under ThreadSanitizer",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 1200
      },
      "filter": {
        "include": {
          "name": "test/libunit/mapm_threads$|test/unit/(multiple_runs|datetime)$|numerics/"
        }
      },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=0:exitcode=0:second_deadlock_stack=1:history_size=4:log_path=${sourceDir}/build/tsan/sanitizer-logs/tsan"
      }
    },
    {
      "name": "tsan-bigint",
      "displayName": "Thread-safety tests under ThreadSanitizer",
      "configurePreset": "tsan-bigint",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 1200
      },
      "filter": {
        "include": {
          "name": "test/libunit/mapm_threads$|test/unit/(multiple_runs|datetime)$|numerics/"
        }
      },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=0:exitcode=0:second_deadlock_stack=1:history_size=4:log_path=${sourceDir}/build/tsan-bigint/sanitizer-logs/tsan"
      }
    },
    {
      "name": "embedded",
      "displayName": "Tests that need no HTTP test server",
      "configurePreset": "embedded",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 120
      },
      "filter": {
        "exclude": {
          "name": "http-client|test/api/validate$|userdefined_uri_resolution|uri_resolvers|streaming-udf|store/example_[13]$|uris/disable-http-3|update/zorba/store/sc1|update/zorba/store/sc2_ex"
        }
      }
    },
    {
      "name": "embedded-noicu",
      "displayName": "Tests that need no HTTP test server",
      "configurePreset": "embedded-noicu",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 120
      },
      "filter": {
        "exclude": {
          "name": "http-client|test/api/validate$|userdefined_uri_resolution|uri_resolvers|streaming-udf|store/example_[13]$|uris/disable-http-3|update/zorba/store/sc1|update/zorba/store/sc2_ex"
        }
      }
    },
    {
      "name": "full-nopch",
      "displayName": "Tests that need no HTTP test server",
      "configurePreset": "full-nopch",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 120
      },
      "filter": {
        "exclude": {
          "name": "http-client|test/api/validate$|userdefined_uri_resolution|uri_resolvers|streaming-udf|store/example_[13]$|uris/disable-http-3|update/zorba/store/sc1|update/zorba/store/sc2_ex"
        }
      }
    },
    {
      "name": "bigint",
      "displayName": "Tests that need no HTTP test server",
      "configurePreset": "bigint",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 120
      },
      "filter": {
        "exclude": {
          "name": "http-client|test/api/validate$|userdefined_uri_resolution|uri_resolvers|streaming-udf|store/example_[13]$|uris/disable-http-3|update/zorba/store/sc1|update/zorba/store/sc2_ex"
        }
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "full-release",
      "displayName": "Configure, build and run all tests (needs the HTTP test server)",
      "steps": [
        { "type": "configure", "name": "full-release" },
        { "type": "build", "name": "full-release" },
        { "type": "test", "name": "full-release" }
      ]
    },
    {
      "name": "full-release-offline",
      "displayName": "Configure, build and run tests that do not need the HTTP test server",
      "steps": [
        { "type": "configure", "name": "full-release" },
        { "type": "build", "name": "full-release" },
        { "type": "test", "name": "full-release-offline" }
      ]
    }
  ]
}
