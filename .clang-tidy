# clang-tidy configuration (run in CI by .github/workflows/clang-tidy.yml).
#
# Enabled checks: unchecked return values (error handling, #17).
#   cert-err33-c                  C standard library functions whose result
#                                 reports an error (fclose, fflush, fwrite,
#                                 remove, rename, ...).
#   bugprone-unused-return-value  clang-tidy's default list plus the pthread
#                                 and POSIX I/O, file system, process and
#                                 socket calls made in src/, modules/ and bin/
#                                 (stdio calls are covered by cert-err33-c and
#                                 not repeated here).
#   clang-diagnostic-unused-result
#                                 The compiler's warning for a discarded
#                                 [[nodiscard]] (or warn_unused_result)
#                                 result, so that the status-returning Zorba
#                                 functions marked [[nodiscard]] are checked
#                                 here too (the build does not use -Werror).
#
# Enabled checks: pointers.
#   readability-delete-null-pointer
#                                 An if statement whose only purpose is to
#                                 skip a delete of a null pointer (delete of
#                                 a null pointer does nothing).
#
# Generated code is excluded: the Bison/Flex output in src/compiler/parser,
# the */pregenerated/* sources and headers, and everything under build/
# (headers configured or generated by CMake). The CI job selects the source
# files; the header part is ExcludeHeaderFilterRegex below.
Checks: >-
  -*,
  cert-err33-c,
  bugprone-unused-return-value,
  clang-diagnostic-unused-result,
  readability-delete-null-pointer
WarningsAsErrors: >-
  cert-err33-c,
  bugprone-unused-return-value,
  clang-diagnostic-unused-result,
  readability-delete-null-pointer
HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: '(/build/|/pregenerated/|/compiler/parser/(xquery|jsoniq)_(parser\.hpp|scanner\.h)$|/compiler/parser/(location\.hh|FlexLexer\.h)$)'
SystemHeaders: false
CheckOptions:
  # A result is ignored on purpose with a (void) cast and a comment saying
  # why (as cert-err33-c already allows).
  bugprone-unused-return-value.AllowCastToVoid: true
  # The first block is clang-tidy's default list (setting the option replaces
  # it); the second block adds the calls Zorba makes.
  bugprone-unused-return-value.CheckedFunctions: >-
    ^::std::async$;
    ^::std::launder$;
    ^::std::remove$;
    ^::std::remove_if$;
    ^::std::unique$;
    ^::std::unique_ptr::release$;
    ^::std::basic_string::empty$;
    ^::std::vector::empty$;
    ^::std::back_inserter$;
    ^::std::distance$;
    ^::std::find$;
    ^::std::find_if$;
    ^::std::inserter$;
    ^::std::lower_bound$;
    ^::std::make_pair$;
    ^::std::map::count$;
    ^::std::map::find$;
    ^::std::map::lower_bound$;
    ^::std::multimap::equal_range$;
    ^::std::multimap::upper_bound$;
    ^::std::set::count$;
    ^::std::set::find$;
    ^::std::setfill$;
    ^::std::setprecision$;
    ^::std::setw$;
    ^::std::upper_bound$;
    ^::std::vector::at$;
    ^::bsearch$;
    ^::ferror$;
    ^::feof$;
    ^::isalnum$;
    ^::isalpha$;
    ^::isblank$;
    ^::iscntrl$;
    ^::isdigit$;
    ^::isgraph$;
    ^::islower$;
    ^::isprint$;
    ^::ispunct$;
    ^::isspace$;
    ^::isupper$;
    ^::iswalnum$;
    ^::iswprint$;
    ^::iswspace$;
    ^::isxdigit$;
    ^::memchr$;
    ^::memcmp$;
    ^::strcmp$;
    ^::strcoll$;
    ^::strncmp$;
    ^::strpbrk$;
    ^::strrchr$;
    ^::strspn$;
    ^::strstr$;
    ^::wcscmp$;
    ^::access$;
    ^::bind$;
    ^::connect$;
    ^::difftime$;
    ^::dlsym$;
    ^::fnmatch$;
    ^::getaddrinfo$;
    ^::getopt$;
    ^::htonl$;
    ^::htons$;
    ^::iconv_open$;
    ^::inet_addr$;
    ^::isascii$;
    ^::isatty$;
    ^::mmap$;
    ^::newlocale$;
    ^::openat$;
    ^::pathconf$;
    ^::pthread_equal$;
    ^::pthread_getspecific$;
    ^::pthread_mutex_trylock$;
    ^::readdir$;
    ^::readlink$;
    ^::recvmsg$;
    ^::regexec$;
    ^::scandir$;
    ^::semget$;
    ^::setjmp$;
    ^::shm_open$;
    ^::shmget$;
    ^::sigismember$;
    ^::strcasecmp$;
    ^::strsignal$;
    ^::ttyname$;
    ^::pthread_[a-z_]+$;
    ^::open$;
    ^::close$;
    ^::read$;
    ^::write$;
    ^::pread$;
    ^::pwrite$;
    ^::fsync$;
    ^::fdatasync$;
    ^::lseek$;
    ^::ftruncate$;
    ^::truncate$;
    ^::munmap$;
    ^::stat$;
    ^::fstat$;
    ^::lstat$;
    ^::mkdir$;
    ^::rmdir$;
    ^::unlink$;
    ^::chdir$;
    ^::getcwd$;
    ^::realpath$;
    ^::opendir$;
    ^::closedir$;
    ^::dup$;
    ^::dup2$;
    ^::pipe$;
    ^::fork$;
    ^::waitpid$;
    ^::kill$;
    ^::setenv$;
    ^::unsetenv$;
    ^::getrlimit$;
    ^::setrlimit$;
    ^::sigaction$;
    ^::socket$;
    ^::listen$;
    ^::accept$;
    ^::send$;
    ^::recv$;
    ^::setsockopt$;
    ^::shutdown$;
    ^::select$;
    ^::poll$
